# Database - Use your Supabase Postgres connection string
# Get it from Supabase → Project Settings → Database → Connection string (URI)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# One-time setup secret (generate a long random string)
SETUP_SECRET="change-me-to-a-long-random-string"

# JWT secret for admin sessions (generate another long random string)
JWT_SECRET="change-me-to-another-long-random-string"
